# ============================================================
# Atlas 环境变量规范（C1.4）
# 复制为 .env.local（前端）/ .env（后端）后填写真实值
# ============================================================

# ---------- 绑定地址（HOST）----------
# 服务监听的网卡地址。云上 pod / 容器内需对外可达，用 0.0.0.0（默认）；
# 仅本机访问可设 127.0.0.1。HOST 为三个服务的统一默认值，可按服务细分覆盖。
HOST=0.0.0.0
# 按服务细分（留空则继承 HOST）
# FRONTEND_HOST=0.0.0.0
# BACKEND_HOST=0.0.0.0
# ASSET_HOST=0.0.0.0

# ---------- 前端（frontend）----------
# 前端 web 服务监听端口（dev / start 通用，默认 3000）
FRONTEND_PORT=3000
# API 网关基址（指向后端服务，端口需与后端 PORT 一致）
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
# 是否启用 Mock 数据（公共部分阶段为 true，联调阶段切 false）
NEXT_PUBLIC_USE_MOCK=true
# 静态素材基址（素材不打包进服务；本地由独立素材服务托管，上线切对象存储/CDN）
NEXT_PUBLIC_ASSET_BASE=http://localhost:4001

# ---------- 素材服务（asset-server，模拟 CDN）----------
# 本地素材静态服务端口，托管仓库根 resources/assets/
ASSET_PORT=4001

# ---------- 后端（backend）----------
# 后端服务端口
PORT=3001
# 本地缓存目录（未接入数据库时的持久化落点：用户账户 users.json / 会话 sessions.json）
CACHE_DIR=./cache
# PostgreSQL
DATABASE_URL=postgresql://atlas:atlas@localhost:5432/atlas
# Redis
REDIS_URL=redis://localhost:6379
# 队列（BullMQ 复用 Redis）
QUEUE_REDIS_URL=redis://localhost:6379
# 对象存储（原图 / 生成图 / 场景资源）
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=atlas-assets
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# ---------- NPC 对话系统（05）----------
# NPC 技能资产目录（后端读盘载入 *.skill.json）
SKILLS_DIR=./resources/skills
# LLM provider 选择：mock | <real>（默认 mock，无真实 LLM 也能跑通联调）
LLM_PROVIDER=mock
# 真实 LLM provider 配置（mock 阶段留空）
LLM_API_BASE=
LLM_API_KEY=
LLM_MODEL=
# Mock LLM 模拟耗时（毫秒）
LLM_MOCK_DELAY_MS=200
# 单会话最大轮次，达上限后会话结束
DIALOGUE_MAX_TURNS=20
